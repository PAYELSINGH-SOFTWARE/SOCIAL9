# Local SQLite fallback:
# DATABASE_URL=sqlite:///./social9.db
# Render external PostgreSQL URL for local development (keep sslmode=require):
DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_HOST:5432/DATABASE?sslmode=require
SOCIAL9_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@social9.in
DEMO_USER_PASSWORD=Social9Demo!
EXPOSE_DEV_AUTH_TOKENS=false
# Set false only for the original Social9 users table without is_verified.
EMAIL_VERIFICATION_ENABLED=true
FRONTEND_URL=http://localhost:3000
# Comma-separated additional browser origins, such as the Vercel preview URL.
CORS_ORIGINS=
OAUTH_MOCK_MODE=true
# Provider overrides let Instagram go live while LinkedIn remains in preview mode.
INSTAGRAM_OAUTH_MOCK_MODE=true
LINKEDIN_OAUTH_MOCK_MODE=true
BILLING_MOCK_MODE=true
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key-before-production
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/social-accounts/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/social-accounts/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202606
INSTAGRAM_API_VERSION=v23.0
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
PUBLISHING_SCHEDULER_ENABLED=false
PUBLISHING_SCHEDULER_INTERVAL_SECONDS=30
# Use local for development. Set s3 in production after configuring the bucket.
MEDIA_STORAGE_BACKEND=local
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_KEY_PREFIX=social9
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Optional override for verifying Meta signed compliance callbacks.
# INSTAGRAM_CLIENT_SECRET is used when this is blank.
META_APP_SECRET=
